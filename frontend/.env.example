# Copy to .env.local for local overrides (gitignored). Not needed for `npm run dev` -- the
# Vite dev server already proxies /api to localhost:8080 (see vite.config.ts).
#
# Required in production (e.g. set as a Vercel project env var): the deployed backend's full
# API base URL, including the /api suffix.
VITE_API_URL=https://europetimemachine-backend.onrender.com/api
